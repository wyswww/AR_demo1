# Unity缓存目录（全部忽略，体积最大）
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/MemoryCaptures/

# VS生成的C#工程文件
.vs/
*.csproj
*.sln
*.suo
*.user
*.userprefs

# 系统垃圾文件
.DS_Store
Thumbs.db
ExportedObj/
.consulo/
# 忽略Vuforia离线压缩包
*.tgz

# 强制必须上传所有.meta文件（Unity资源引用核心，不能忽略）
!/[Aa]ssets/**/*.meta
